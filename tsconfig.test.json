{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Disabled for tests to allow for unused variables/parameters in test setups
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
